		<isee:time_format name="Builtin" type="adaptive"/>
	</isee:time_formats>
	<default_format/>
	<model_units/>
	<model>
		<variables>
			<aux name="Chinese Orchestra's\nOccupancy of Inventory Area">
				<eqn>NAN(Chinese_Orchestra&apos;s_Convenience)</eqn>
				<isee:delay_aux/>
			</aux>
			<aux name="Chinese Orchestra's\nConvenience">
				<eqn>NAN(Chinese_Orchestra&apos;s_Occupancy_of_Inventory_Area,Convenience_Per_Individual_Group)</eqn>
				<isee:delay_aux/>
			</aux>
			<aux name="Symphony Orchestra's\nOccupancy of Inventory Area">
				<eqn>NAN(Symphony_Orchestra&apos;s_Convenience)</eqn>
				<isee:delay_aux/>
			</aux>
			<aux name="Symphony Orchestra's\nConvenience">
				<eqn>NAN(Symphony_Orchestra&apos;s_Occupancy_of_Inventory_Area,Convenience_Per_Individual_Group)</eqn>
				<isee:delay_aux/>
			</aux>
			<aux name="Total Occupancy\nof Shared Inventory Area">
				<eqn>NAN(Chinese_Orchestra&apos;s_Occupancy_of_Inventory_Area,Symphony_Orchestra&apos;s_Occupancy_of_Inventory_Area)</eqn>
				<isee:delay_aux/>
			</aux>
			<aux name="Convenience Per\nIndividual Group">
				<eqn>NAN(Availability_of_Shared_Inventory_Area)</eqn>
				<isee:delay_aux/>
			</aux>
			<aux name="Time to Clear the Inventory Area">
				<eqn>NAN(Convenience_Per_Individual_Group,Number_of_Student_Helping)</eqn>
				<isee:delay_aux/>
			</aux>
			<aux name="Current Room\nSpace Available">
				<eqn>NAN(Numbers_of_Items_Cleaned_up)</eqn>
				<isee:delay_aux/>
			</aux>
			<aux name="Desired Room Space">
				<isee:delay_aux/>
			</aux>
			<aux name="Needs to Clean up Unattended Items">
				<eqn>NAN(Desired_Room_Space,Current_Room_Space_Available)</eqn>
				<isee:delay_aux/>
			</aux>
			<aux name="Numbers of Items\nCleaned up">
				<eqn>NAN(Needs_to_Clean_up_Unattended_Items,Room_Usage_Shortfall,Number_of_Student_Helping)</eqn>
				<isee:delay_aux/>
			</aux>
			<aux name="Time to Clean up\nthe Practice Room">
				<eqn>NAN(Numbers_of_Items_Cleaned_up,Number_of_Student_Helping)</eqn>
				<isee:delay_aux/>
			</aux>
			<aux name="Number of Student Helping">
				<eqn>NAN(Willingness_to_Help)</eqn>
				<isee:delay_aux/>
			</aux>
			<aux name="Total Preparation Time">
				<eqn>NAN(Time_to_Clear_the_Inventory_Area,Time_to_Clean_up_the_Practice_Room)</eqn>
				<isee:delay_aux/>
			</aux>
			<aux name="Willingness to Help">
				<eqn>NAN(Total_Preparation_Time)</eqn>
				<isee:delay_aux/>
			</aux>
			<aux name="Availability of Shared Inventory Area">
				<eqn>NAN(Total_Occupancy_of_Shared_Inventory_Area,Capacity_of_Shared_Inventory_Area)</eqn>
				<isee:delay_aux/>
			</aux>
			<aux name="Capacity of Shared Inventory Area">
				<isee:delay_aux/>
			</aux>
			<aux name="Room Usage Shortfall">
				<isee:delay_aux/>
			</aux>
		</variables>
